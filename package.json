{
  "name": "trading-vault",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "KYROS_APP=public vite",
    "dev:backoffice": "KYROS_APP=backoffice vite",
    "build": "rm -rf dist && tsc -b && vitest run && KYROS_APP=backoffice vite build && KYROS_APP=public vite build",
    "deploy": "npm run build && npm run deploy:prebuilt",
    "deploy:prebuilt": "env -u WRANGLER_CI_OVERRIDE_NAME -u WRANGLER_CI_MATCH_TAG wrangler deploy --config dist/backoffice/vaults_backoffice/wrangler.json && wrangler deploy --config dist/vaults_frontend/wrangler.json",
    "preview": "KYROS_APP=public vite build && vite preview",
    "preview:backoffice": "KYROS_APP=backoffice vite build && vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen": "node codama.config.mjs"
  },
  "dependencies": {
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/client": "^1.7.0",
    "@solana/connector": "^0.2.4",
    "@solana/kit": "^5.5.1",
    "@solana/react-hooks": "^1.4.1",
    "@tanstack/react-query": "^5.62.0",
    "@walletconnect/universal-provider": "^2.23.9",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "^4.20260529.1",
    "@codama/nodes-from-anchor": "^1.4.1",
    "@codama/renderers-js": "^1.5.5",
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "codama": "^1.6.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.6",
    "wrangler": "^4.95.0"
  }
}
